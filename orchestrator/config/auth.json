{
  "providers": {
    "deepseek": {
      "authType": "api_key",
      "oauth": false,
      "multiAccount": true,
      "defaultMaxConnections": 10,
      "hardLimit": null
    },
    "openai": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "anthropic": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "google": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "xai": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "nvidia": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "groq": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "mistral": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "cohere": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "together": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    },
    "openrouter": {
      "multiAccount": true,
      "defaultMaxConnections": 10
    }
  },
  "rotation": {
    "on": [
      "RATE_LIMIT",
      "AUTH_ERROR",
      "QUOTA_EXCEEDED",
      "PROVIDER_DOWN"
    ],
    "strategy": "least-recently-used-then-oldest-available"
  },
  "capacity": {
    "maxAccounts": 100,
    "maxProviders": 10,
    "accountsPerProvider": 10,
    "expandable": true
  }
}