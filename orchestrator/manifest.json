{
  "name": "creazzy-universal-orchestrator",
  "version": "1.0.0",
  "type": "orchestrator",
  "description": "Provider-agnostic multi-model, multi-agent universal plugin runtime",
  "capabilities": [
    "chat",
    "vision",
    "audio",
    "video",
    "files",
    "code",
    "tools",
    "json",
    "mcp",
    "memory",
    "routing",
    "fallback",
    "multi-account"
  ],
  "providers": [
    "openai",
    "anthropic",
    "google",
    "xai",
    "deepseek",
    "mistral",
    "groq",
    "openrouter",
    "nvidia",
    "cohere",
    "together",
    "fireworks",
    "perplexity",
    "cerebras",
    "sambanova",
    "deepinfra",
    "ai21",
    "moonshot",
    "zhipu",
    "minimax",
    "siliconflow",
    "novita",
    "nebius",
    "friendli",
    "hyperbolic",
    "lepton",
    "sao10k",
    "upstage",
    "databricks",
    "azure-openai",
    "vertex-ai",
    "huggingface",
    "replicate",
    "cloudflare-workers-ai",
    "ollama",
    "lm-studio",
    "vllm"
  ],
  "failureModes": [
    "AUTH_ERROR",
    "RATE_LIMIT",
    "QUOTA_EXHAUSTED",
    "TIMEOUT",
    "UNSUPPORTED_CAPABILITY",
    "INVALID_REQUEST",
    "PROVIDER_DOWN",
    "MODEL_ERROR"
  ],
  "routing": {
    "strategy": "capability-health-fallback",
    "maxAttempts": 4
  },
  "security": {
    "secretsFromEnvironment": true,
    "encryptedAtRest": true,
    "neverLogCredentials": true,
    "noBrowserTokenScraping": true
  },
  "ui": "/ui",
  "api": "/v1/chat/completions"
}
